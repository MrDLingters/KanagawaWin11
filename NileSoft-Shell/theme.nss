theme
{
	name = "modern"

	view = view.medium

	background
	{
		color = #1F1F28
		opacity = 100
		// effect = 2
	}

	item
	{
		opacity = 100

		prefix = 1

		text
		{
			normal = #DCD7BA
			select = #DCD7BA
			normal-disabled = #727169
			select-disabled = #727169
		}

		back
		{
			select = #76946A
			select-disabled = #727169
		}
	}

	// font
	// {
	// 	size = 14
	// 	name = "Segoe UI Variable Text"
	// 	weight = 3
	// 	italic = 0
	// }

	border
	{
		enabled = true
		size = 1
		color = #C0A36E
		opacity = 100
		radius = 16
	}

	shadow
	{
		enabled = true
		size = 5
		opacity = 5
		color = #11111b
	}

	separator
	{
		size = 1
		color = #1F1F28
	}

	symbol
	{
		normal = #DCD7BA
		select = #DCD7BA
		normal-disabled = #C8C093
		select-disabled = #C8C093
	}

	image
	{
		enabled = true
		color = [#DCD7BA, #DCD7BA, #DCD7BA]
	}
}